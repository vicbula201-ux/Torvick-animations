 "frases": [
  {
   "ini": 0.127,
   "fin": 3.367,
   "texto": "¿qué tan saludable realmente es el aguacate?"
  },
  {
   "ini": 3.473,
   "fin": 8.567,
   "texto": "tiene más calorías que muchas frutas, pero eso no significa que sea un mal alimento."
  },
  {
   "ini": 8.673,
   "fin": 12.273,
   "texto": "por cada 100 gramos tenemos 160 calorías."
  },
  {
   "ini": 12.533,
   "fin": 17.893,
   "texto": "15 gramos de grasa, 7 gramos de fibra y 2 gramos de proteína."
  },
  {
   "ini": 18.88,
   "fin": 20.96,
   "texto": "y aquí viene realmente lo interesante."
  },
  {
   "ini": 20.96,
   "fin": 27.68,
   "texto": "sus grasas son monoinsaturadas, es decir, las grasas saludables muy parecidas a las del aceite de oliva."
  },
  {
   "ini": 28.72,
   "fin": 39.373,
   "texto": "su combinación de fibra y de grasa puede ayudarte a sentirte más satisfecho y que puede ayudarte a la absorción de ciertas vitaminas de otros alimentos ¿y cómo comerlo?"
  },
  {
   "ini": 39.507,
   "fin": 45.167,
   "texto": "puedes acompañarlo con arepa, huevos, atún o incluso en una ensalada con otros vegetales."
  },
  {
   "ini": 45.273,
   "fin": 50.793,
   "texto": "mi veredicto honesto sobre el aguacate, yo le doy un sólido 9 de 10."
  },
  {
   "ini": 51.073,
   "fin": 54.033,
   "texto": "es nutritivo, versátil y bastante delicioso."
  },
  {
   "ini": 54.14,
   "fin": 59.58,
   "texto": "eso sí, recuerda que las porciones importan y te estarás comiendo más o menos calorías del aguacate."
  },
  {
   "ini": 59.68,
   "fin": 61.6,
   "texto": "¿con qué acompañas el aguacate?"
  },
  {
   "ini": 61.6,
   "fin": 62.7,
   "texto": "te leo en los comentarios."
  },
  {
   "ini": 62.833,
   "fin": 64.913,
   "texto": "¿quieres ver más videos similares?"
  },
  {
   "ini": 64.913,
   "fin": 66.633,
   "texto": "sígueme para más contenido."
  }
 ],
